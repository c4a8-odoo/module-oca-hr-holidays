<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- A public holiday location standing for the hr demo work location.
         Linking the work location makes everybody working there follow, the
         way the install bootstrap would; the demo just does it with a
         readable name before the hook runs. -->
    <record id="location_building_1" model="resource.calendar.location">
        <field name="name">Building 1</field>
        <field name="company_id" ref="base.main_company" />
    </record>
    <record id="hr.work_location_1" model="hr.work.location">
        <field name="resource_calendar_location_id" ref="location_building_1" />
    </record>

    <!-- A day only the people of Building 1 get: generated per person, for
         everybody whose work location stands for that location. -->
    <record id="public_holiday_line_building_day" model="calendar.public.holiday.line">
        <field name="name">Building 1 Anniversary</field>
        <field name="date" eval="time.strftime('%Y-09-12')" />
        <field name="variable_date" eval="False" />
        <field
            name="public_holiday_id"
            ref="calendar_public_holiday_resource.public_holiday_demo"
        />
        <field name="location_ids" eval="[Command.set([ref('location_building_1')])]" />
    </record>
</odoo>
