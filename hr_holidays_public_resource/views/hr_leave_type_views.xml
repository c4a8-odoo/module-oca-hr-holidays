<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Public holidays exist as global time off here, so the standard
         "Ignore Public Holidays" setting of the leave type decides whether a
         leave counts them; the OCA flag of hr_holidays_public drives an
         engine this module switches off. -->
    <record id="edit_holiday_status_form" model="ir.ui.view">
        <field name="name">hr.leave.type.form.public.holiday.resource</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays_public.edit_holiday_status_form" />
        <field name="arch" type="xml">
            <group name="public_holidays" position="attributes">
                <attribute name="invisible">1</attribute>
            </group>
        </field>
    </record>
</odoo>
