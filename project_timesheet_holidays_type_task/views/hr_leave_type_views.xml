<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="edit_holiday_status_form" model="ir.ui.view">
        <field name="name">hr.leave.type.form.timesheet.project.task</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form" />
        <field name="arch" type="xml">
            <field name="create_calendar_meeting" position="after">
                <field name="timesheet_project_id" invisible="time_type == 'other'" />
                <field
                    name="timesheet_task_id"
                    invisible="time_type == 'other' or not timesheet_project_id"
                />
            </field>
        </field>
    </record>
</odoo>
